# ============================================================
# AI Blog Automation Engine — Environment Variables
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/blog_automation?schema=public"

# --- Strapi CMS ---
STRAPI_BASE_URL="https://your-strapi-domain.com"
STRAPI_API_TOKEN="your-strapi-api-token-here"

# --- Google Gemini AI ---
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.0-flash"

# --- Redis (for BullMQ) ---
REDIS_HOST="localhost"
REDIS_PORT=6379

# --- Scheduler ---
# Cron expression: runs daily at 6:00 AM server time
DAILY_CRON="0 6 * * *"
# Number of blog posts to generate per daily batch
POSTS_PER_DAY=5

# --- Branding ---
BRAND_NAME="YourBrand"

# --- Node Environment ---
NODE_ENV="production"
