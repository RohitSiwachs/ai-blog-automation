# ============================================================
# AI Blog Automation Engine — Environment Variables
# ============================================================

# --- Database ---
DATABASE_URL="YOUR postgresql url"

# --- Strapi CMS ---
STRAPI_BASE_URL="YOUR strapi base url"
STRAPI_API_TOKEN="YOUR strapi api token"
BLOG_SITE_URL="YOUR blog site url"


# --- AI Provider ---
# Options: "gemini", "nvidia"
AI_PROVIDER="YOUR AI PROVIDER"

# --- Google Gemini AI ---
GEMINI_API_KEY= YOUR GEMINI API KEY 
GEMINI_MODEL="YOUR MODEL"

# --- NVIDIA NIM AI ---
NVIDIA_API_KEY="YOUR NVIDIA API KEY"
NVIDIA_MODEL="YOUR NVIDIA MODEL"
NVIDIA_IMAGE_API_KEY="YOUR NVIDIA IMAGE API KEY"

# --- Redis (Upstash) ---
REDIS_HOST="YOUR REDIS HOST"
REDIS_PORT="YOUR REDIS PORT"
REDIS_PASSWORD="YOUR REDIS PASSWORD"
REDIS_TLS=true


# --- Scheduler ---
# Cron expression: runs every 3 hours
DAILY_CRON="0 */3 * * *"
# Number of blog posts to generate per daily batch
POSTS_PER_DAY=1

# --- Branding ---
BRAND_NAME="YourBrand"

# --- Node Environment ---
NODE_ENV="production"

# --- OpenAI ---
OPENAI_API_KEY="YOUR OpenAI API KEY"
NVIDIA_NIM_API_KEY="YOUR NVIDIA NIM API KEY"

BYPASS_STRAPI=false
